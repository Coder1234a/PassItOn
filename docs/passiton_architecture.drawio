<mxfile host="app.diagrams.net"><diagram name="System architecture" id="arch"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="&lt;b&gt;PassItOn: system architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:12px&#x27;&gt;VIT-only AI help network. Built with a phone web app, a Flask API and six AI agents.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="50" as="geometry"/></mxCell><mxCell id="u1" value="&lt;b&gt;First-year student&lt;/b&gt;&lt;br&gt;asks, swipes for a senior, grabs items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="160" y="80" width="260" height="60" as="geometry"/></mxCell><mxCell id="u2" value="&lt;b&gt;Senior (2nd year+)&lt;/b&gt;&lt;br&gt;answers once, accepts, passes items on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="80" width="260" height="60" as="geometry"/></mxCell><mxCell id="u3" value="&lt;b&gt;Faculty advisor (planned)&lt;/b&gt;&lt;br&gt;dashboard of what first years struggle with" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="960" y="80" width="260" height="60" as="geometry"/></mxCell><mxCell id="app" value="&lt;b&gt;Phone web app (HTML, CSS, JS, no install)&lt;/b&gt;&lt;br&gt;Junior: Ask · Swipe seniors · Market · Matches   |   Senior: Questions · Requests · Pass it on · Me   |   tutorial, two-phone demo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="120" y="190" width="1140" height="64" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API server: Python Flask on Render (Gunicorn)&lt;/b&gt;&lt;br&gt;REST: /ask /deck /request /respond /answer /listing /publish · live state, 3-second sync · VIT email login (planned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="120" y="290" width="1140" height="54" as="geometry"/></mxCell><mxCell id="orc" value="&lt;b&gt;Orchestrator agent&lt;/b&gt;&lt;br&gt;runs the agents in order (max 6 steps), records the trace shown as “How the AI got this”, falls back to rules offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="120" y="380" width="1140" height="60" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;1. Safety agent&lt;/b&gt;&lt;br&gt;content filter: abuse, cheating, proxies, off-topic (rules)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="120" y="480" width="175" height="120" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;2. Intake agent&lt;/b&gt;&lt;br&gt;course, topic, urgency from a messy question (Gemini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="313" y="480" width="175" height="120" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;3. Ask agent&lt;/b&gt;&lt;br&gt;top 3 senior tips; answers only from them, else hands off (TF-IDF + Gemini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="506" y="480" width="175" height="120" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;4. Match agent&lt;/b&gt;&lt;br&gt;ranks seniors: course 45%, topic, rating, reply rate, free soon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="699" y="480" width="175" height="120" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;5. Coordination agent&lt;/b&gt;&lt;br&gt;free slot, campus spot, drafts the first message (Gemini)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="892" y="480" width="175" height="120" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;6. Listing agent&lt;/b&gt;&lt;br&gt;photo or one line → listing, pings juniors who want it (Gemini vision)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1085" y="480" width="175" height="120" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Knowledge base&lt;/b&gt;&lt;br&gt;senior-approved tips; each new senior answer is added" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="120" y="660" width="270" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Seniors, items, wanted, places&lt;/b&gt;&lt;br&gt;tables loaded with pandas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="410" y="660" width="270" height="80" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Live state (in memory)&lt;/b&gt;&lt;br&gt;requests, matches, questions, points" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="700" y="660" width="270" height="80" as="geometry"/></mxCell><mxCell id="d4" value="&lt;b&gt;Survey dataset&lt;/b&gt;&lt;br&gt;27 real responses; shapes rows, market, free help" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="990" y="660" width="270" height="80" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;LLM API&lt;/b&gt;&lt;br&gt;Gemini 3.5 Flash-Lite; used by Intake, Ask, Coordination, Listing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1290" y="470" width="230" height="74" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b&gt;TF-IDF search&lt;/b&gt;&lt;br&gt;scikit-learn on the server; used by Ask and Match" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1290" y="556" width="230" height="74" as="geometry"/></mxCell><mxCell id="x3" value="&lt;b&gt;Neon Postgres (planned)&lt;/b&gt;&lt;br&gt;replaces in-memory state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="648" width="230" height="64" as="geometry"/></mxCell><mxCell id="x4" value="&lt;b&gt;GitHub → Render&lt;/b&gt;&lt;br&gt;every push redeploys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;arcSize=8;dashed=1;" vertex="1" parent="1"><mxGeometry x="1290" y="732" width="230" height="64" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u1" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u2" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="u3" target="app"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="app" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="orc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="orc" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="orc" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="orc" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="orc" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="orc" target="a5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="orc" target="a6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="retrieve tips" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a4" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a5" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a6" target="x1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a6" target="x2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="migrate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="d3" target="x3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lg" value="Legend: yellow = users · purple = app and server · green = AI agents · blue = data · orange = knowledge base · red = AI and ML services · grey dashed = planned" style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="810" width="1400" height="30" as="geometry"/></mxCell><mxCell id="fw" value="Flywheel: when the Ask agent can&#x27;t answer, the question goes to seniors; one senior answers once, the answer joins the knowledge base, and every later junior gets it instantly." style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="840" width="1400" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>